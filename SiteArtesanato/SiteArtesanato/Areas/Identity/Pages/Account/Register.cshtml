                                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                }
                            </p>
                        </div>
                    </form>
                }
            }
        </section>
    </div> *@
</div>

<script>
    function buscaCep(){
        var _cep = $("#cep").val();
        console.log(cep);
        var dados = {cep:_cep};
        $.ajax({
            type:"POST",
            dataType:"json",
            data:dados,
            url:'@Url.Action("PreencheEndereco", "Clientes")',
            success: function (resposta){
                document.getElementById("logradouroId").value = resposta.logradouro;
                document.getElementById("bairroId").value = resposta.bairro;
                document.getElementById("cidadeId").value = resposta.cidade;
                document.getElementById("estadoId").value = resposta.estado;

            }
        });
    }
    function limpaCampos(){
                document.getElementById("logradouroId").value = "";
                document.getElementById("bairroId").value = "";
                document.getElementById("cidadeId").value = "";
                document.getElementById("estadoId").value = "";
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
